# Model provider: set ONE of these. Gemini (free tier) is the default demo setup;
# if ANTHROPIC_API_KEY is set it takes precedence (override with LLM_PROVIDER=gemini|anthropic).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional Gemini model chains (comma-separated, tried in order)
# GEMINI_WRITER_MODELS=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.5-flash-lite
# GEMINI_FAST_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional: require a passcode for live generation on the public demo
DEMO_PASSCODE=
# Set automatically when a Vercel Blob store is connected; without it guides are saved to ./.data
BLOB_READ_WRITE_TOKEN=
